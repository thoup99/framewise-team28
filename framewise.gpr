with "bedrock";

library project Framewise is
   for Library_Name use "framewise";
   for Library_Version use "0.1.0";
   for Library_Kind use "static";

   for Source_Dirs use ("src", "bindings");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa",
         "-gnatyg", "-gnaty-d", "-gnatyM100", "-g", "-O1", "-fstack-check");
   end Compiler;

   package Linker is
      for Linker_Options use
        ("-LC:/ffmpeg/lib",
         "-lavformat",
         "-lavcodec",
         "-lavutil",
         "-lswscale",
         "-lswresample");
   end Linker;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "-j0");
   end Prove;
end Framewise;
