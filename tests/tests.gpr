with "framewise";

project Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("tests.adb", "box_reader_tests.adb", "p1_foundation_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe", "-gnatVa", "-gnatyg", "-gnaty-d", "-gnatyM100", "-g", "-O2");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      for Linker_Options use
        ("-LC:/ffmpeg/lib",
         "-lavformat");
   end Linker;
end Tests;
