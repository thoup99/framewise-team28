with "framewise";
with "adi.gpr";

project Ui_Checks is
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj/checks";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("timeline_view_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-g");
   end Compiler;

   package Linker is
      for Linker_Options use
        ("-LC:/msys64/mingw64/lib");
   end Linker;

end Ui_Checks;
