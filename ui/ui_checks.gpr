with "framewise";
with "adi.gpr";

project Ui_Checks is
   type Platform_Kind is ("linux", "darwin", "windows");
   Platform : Platform_Kind := external ("ADI_PLATFORM", "linux");
   for Source_Dirs use ("src", "tests");
   for Object_Dir use "obj/checks";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("timeline_view_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-g");
   end Compiler;

   package Linker is
      case Platform is
         when "windows" =>
            for Linker_Options use ("-LC:/msys64/mingw64/lib");
         when others =>
            null;
      end case;
   end Linker;

end Ui_Checks;
